# ============================================================
# SHANAN Platform — Environment Configuration
# Copy this file to .env and configure for your environment.
# ============================================================

# ---- Application ----
NODE_ENV=development

# ---- Database ----
# SQLite database file path. Use forward slashes even on Windows.
# For development: a relative path from the project root
DATABASE_URL=file:./db/custom.db

# For production: an absolute path or a cloud database URL
# DATABASE_URL=file:/var/lib/shanan/custom.db

# ---- API Server ----
PORT=3001
# Comma-separated list of additional CORS origins
# EXTRA_CORS_ORIGINS=https://your-domain.com

# ---- Frontend ----
# The API URL the frontend uses to connect to the backend
VITE_API_URL=http://localhost:3001

# ---- Storage Provider ----
# Options: local, s3, azure, gcs
STORAGE_PROVIDER=local

# Local storage base path (relative to project root for dev)
STORAGE_BASE_PATH=./storage

# Public URL for serving stored files (e.g. CDN URL in production)
# STORAGE_PUBLIC_URL=https://cdn.your-domain.com

# ---- S3 Storage Configuration (only if STORAGE_PROVIDER=s3) ----
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=your-shanan-bucket
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_FORCE_PATH_STYLE=false

# ---- Authentication ----
# Session duration in milliseconds (default: 24 hours = 86400000)
# SESSION_DURATION_MS=86400000

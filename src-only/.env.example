# ============================================================
# SHANAN Platform — Environment Configuration
# Copy this file to .env (local) or to the corresponding
# Vercel/Supabase environment (PREVIEW and PRODUCTION) when
# setting up a new deployment.
#
# NEVER commit real values. Use placeholders only.
#
# Runtime env reads (verified 2026-09-11 in P0-00B):
#   api/auth and api/[[...route]] use:
#     SUPABASE_DB_URL, SUPABASE_SSL_CA, LOGIN_MAX_REQUESTS,
#     LOGIN_WINDOW_MS, STORAGE_*, S3_*, SESSION_DURATION_MS
#   The frontend build reads only VITE_API_URL (build-time, inlined).
# ============================================================

# ---- Runtime environment ----
# LOCAL | PREVIEW | PRODUCTION
NODE_ENV=development

# ---- Database (Supabase PostgreSQL — production runtime) ----
# SUPABASE_DB_URL is REQUIRED by the API at first request; the server
# throws if it is absent. Use the Supabase connection string WITHOUT
# secret characters in this example — supply the real pooler/direct URL
# in the Vercel environment only.
# SUPABASE_DB_URL=postgresql://user:password@host:5432/dbname
# SUPABASE_SSL_CA=-----BEGIN CERTIFICATE----- ... -----END CERTIFICATE-----

# ---- API Server (legacy local Bun server only) ----
# Port 3001 is used exclusively by the legacy local server
# (legacy/api/server.ts). It is NOT used by Vercel serverless.
PORT=3001
# Comma-separated list of additional CORS origins (legacy server only)
# EXTRA_CORS_ORIGINS=https://your-domain.com

# ---- Frontend ----
# The API URL the frontend uses to connect to the backend.
# Build-time only: inlined by Vite. Set per environment.
# In PRODUCTION on Vercel this is the deployed https origin under which
# /api/* is served by the serverless function.
VITE_API_URL=https://your-app.vercel.app

# ---- Storage Provider ----
# Options: local (default), s3
STORAGE_PROVIDER=local
# Local storage base path. On Vercel serverless this is ephemeral
# (/tmp); prefer S3 in PRODUCTION for persistent artifacts.
STORAGE_BASE_PATH=/tmp/shanan-storage
# Public URL for serving stored files (e.g. CDN URL in production)
# STORAGE_PUBLIC_URL=https://cdn.your-domain.com

# ---- S3 Storage Configuration (only if STORAGE_PROVIDER=s3) ----
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=your-shanan-bucket
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_FORCE_PATH_STYLE=false

# ---- Authentication ----
# Session duration in milliseconds (default: 24 hours = 86400000)
# SESSION_DURATION_MS=86400000
# Login rate limiting (defaults: 20 requests / 900000 ms window)
# LOGIN_MAX_REQUESTS=20
# LOGIN_WINDOW_MS=900000

# ---- Misc API tuning (defaults applied if unset) ----
# MAX_IMAGE_SIZE_MB=10
# ANALYSIS_WINDOW_DAYS=30